    <parent link="base_link"/>
    <child link="top_camera_mount_link"/>
  </joint>

  <!-- Origin is the center of cylindrical faces 136-139 (the four camera holes). -->
  <link name="top_camera_optical_frame"/>
  <joint name="top_camera_optical_joint" type="fixed">
    <origin xyz="0.0240677843137 0.123503610039 0.518141729889" rpy="2.7488972451 0 1.5708"/>
    <parent link="base_link"/>
    <child link="top_camera_optical_frame"/>
