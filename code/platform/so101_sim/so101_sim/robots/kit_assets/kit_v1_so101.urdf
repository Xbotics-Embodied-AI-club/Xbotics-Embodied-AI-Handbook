    <parent link="base_link"/>
    <child link="kit_base_plate_link"/>
  </joint>

  <link name="frame_extrusion_link">
    <visual>
      <geometry><mesh filename="assets/frame_extrusion.stl"/></geometry>
      <material name="aluminum"/>
    </visual>
    <collision>
      <geometry><mesh filename="assets/frame_extrusion.stl"/></geometry>
    </collision>
  </link>
  <joint name="frame_extrusion_joint" type="fixed">
